<?xml version="1.0" encoding="utf-8"?>
<!--
  Track and fill for the progress bar. Drawn as a layer-list rather than using the
  platform ProgressBar style, because the platform one picks up the launcher's
  accent colour and would not be the app's aqua.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_aqua_wash" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="left">
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_aqua" />
                <corners android:radius="4dp" />
            </shape>
        </clip>
    </item>
</layer-list>
