<?xml version="1.0" encoding="utf-8"?>
<!--
  The next-dose widget. Same RemoteViews-safe view set as the water widget.

  The "Taken" button is a sibling of the text rather than overlaying it, because a
  RemoteViews tap target has to be a real view with its own bounds — and because
  the button needs to disappear cleanly on days when there is nothing left to take.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/medicine_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:maxLines="1"
            android:textColor="@color/widget_ink_soft"
            android:text="@string/widget_medicine_label" />

        <TextView
            android:id="@+id/medicine_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widget_ink_soft"
            android:text="0/0" />
    </LinearLayout>

    <TextView
        android:id="@+id/medicine_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_ink"
        android:text="@string/widget_medicine_none" />

    <TextView
        android:id="@+id/medicine_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_ink_soft"
        android:text="@string/widget_medicine_none_detail" />

    <!-- Pushes the button to the bottom edge at any widget height the user
         stretches to, so it stays where the thumb expects it.

         A FrameLayout rather than a Space: RemoteViews only inflates the handful
         of view classes marked @RemoteView, and Space is not one of them — it
         would throw at inflation time and the widget would never appear. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/medicine_taken"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:background="@drawable/widget_button"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:textColor="@color/widget_on_accent"
        android:text="@string/widget_medicine_taken" />
</LinearLayout>
